# Environment Variables
# Copy this file to .env and fill in your values

# MongoDB Connection String
# For local development: mongodb://localhost:27017/basa-forms
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/basa-forms
MONGODB_URI=mongodb://localhost:27017/basa-forms

# Server Port (Render will set PORT automatically)
PORT=3000

# Admin PIN for accessing submitted data (change this!)
ADMIN_PIN=BASA2025